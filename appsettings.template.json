{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=PollenForYouDb;Trusted_Connection=True;MultipleActiveResultSets=true;TrustServerCertificate=True"
  },
  "Jwt": {
    "Key": "<YOUR_JWT_SECRET_KEY>",
    "Issuer": "PollenForYouApi",
    "Audience": "PollenForYouAdmin",
    "AccessTokenLifetimeMinutes": 15,
    "RefreshTokenLifetimeDays": 7
  },
  "DefaultAdmin": {
    "Email": "admin@example.com",
    "Password": "<YOUR_ADMIN_PASSWORD>"
  },
  "RateLimiting": {
    "CheckoutPermitLimit": 10,
    "CheckoutWindowSeconds": 60
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
